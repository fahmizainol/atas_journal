.env

# ---- data ----
# ~4.5G: the Databento tick cache, sim run artifacts, Rithmic recordings, the
# journal DB and study outputs. All of it is either regenerable (`python -m
# journal.sim.run`), re-purchasable, or a local database — none of it belongs in
# history, and it was making `git status` unreadable.
#
# The exception is the hand-written analysis scripts under data/research: those
# are source. Re-including them needs the walk down to be re-enabled at every
# level, because git will not descend into an excluded directory — hence the
# alternating exclude/negate pairs rather than one `data/` line.
data/*
!data/drafts/
!data/research/
data/research/*
!data/research/*/
data/research/*/*
!data/research/*/*.py
__pycache__/
*.pyc
.venv/
.uv/
# Kronos (OHLCV foundation model) — an ISOLATED venv + the upstream clone, kept
# out of .venv because Kronos hard-pins pandas==2.2.2 and this project runs 3.0.3
# under the live feed. Recreate: `uv venv .venv-kronos --python 3.12`,
# `git clone --depth 1 https://github.com/shiyu-coder/Kronos .kronos`, then
# install torch from the CPU index followed by .kronos/requirements.txt.
.venv-kronos/
.kronos/

# frontend
frontend/node_modules/
frontend/dist/
frontend/.tsbuild/
frontend/.vite/
*.tsbuildinfo
data/imports/**/*.xlsx
data/*.bak
# Sim run artifacts — regenerate with `python -m journal.sim.run --both`.
# data/sims/

# The vendored scheduler's build tree — half a gigabyte of it. Rebuild with
# `cargo build --release --manifest-path vendor/sm20/Cargo.toml`; the deck falls
# back to SM-2 until you do, so a clone without a Rust toolchain still works.
vendor/sm20/target/

# Third-party Pine pulled by tools/pine-fetch — other people's published source,
# kept for transcription reference (see lib/pineStudy). Not ours to redistribute,
# and re-fetchable from the script URL at any time.
data/pine/
